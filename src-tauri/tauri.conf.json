{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../frontend/dist"
  },
  "package": {
    "productName": "Pacekeeper",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"]
      },
      "shell": {
        "all": true,
        "open": true,
        "execute": true,
        "sidecar": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "Copyright © 2026 Pacekeeper",
      "deb": {
        "depends": []
      },
      "externalBin": [
        "binaries/pacekeeper-backend"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.pacekeeper.app",
      "longDescription": "Adaptive Lesson & Spaced-Revision Planner Desktop Application",
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": ""
      },
      "resources": [],
      "shortDescription": "Pacekeeper Desktop App",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 850,
        "resizable": true,
        "title": "Pacekeeper Desktop — Adaptive Lesson & Spaced Revision Planner",
        "width": 1300
      }
    ]
  }
}
